@model IEnumerable<RRHHManager.Models.Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>

<p>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo Empleado</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Identidad</th>
            <th>Correo</th>
            <th>Departamento</th>
            <th>Puesto</th>
            <th>Fecha Ingreso</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                <td>@Html.DisplayFor(modelItem => item.Identidad)</td>
                <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                <td>@Html.DisplayFor(modelItem => item.Departamento.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Puesto.Nombre)</td>
                <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                <td>
                    <span class="badge bg-@(item.Estado == RRHHManager.Models.EstadoEmpleado.Activo ? "success" : "secondary")">
                        @item.Estado
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>