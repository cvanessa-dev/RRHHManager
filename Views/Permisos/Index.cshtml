@model IEnumerable<RRHHManager.Models.Permisos>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Rol)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Modulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuedeVer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuedeCrear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuedeEditar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuedeEliminar)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Rol.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Modulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PuedeVer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PuedeCrear)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PuedeEditar)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PuedeEliminar)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
